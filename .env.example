# Copie para .env. Use chaves da sua conta para o chat e a pesquisa.
OPENAI_API_KEY=
MODEL_WRITE=gpt-4o-mini
MODEL_PESQUISA=gpt-4o-mini
MODEL_CHAT=gpt-4o-mini
MODEL_PLANILHA=gpt-4o-mini
TAVILY_API_KEY=

# Opcional: cliente OAuth do Google do tipo Aplicativo da Web.
ID_CLIENT=
KEY_CLIENT=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Obtenha a service_role do Supabase local. Mantenha a chave no backend.
# Sem Docker, SUPABASE_URL usa http://127.0.0.1:54321 por padrão.
# Com Docker, a conexão local usa http://host.docker.internal:54321.
# SUPABASE_URL=
SUPABASE_KEY=
