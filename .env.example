# Copie para .env e preencha as duas chaves para pesquisar vagas.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Tavily: https://app.tavily.com/
TAVILY_API_KEY=

# Modelos da OpenAI. Opções: gpt-6-luna, gpt-6.1-terra, gpt-6.2-sol.
MODEL_WRITE=gpt-6-luna
MODEL_PESQUISA=gpt-6-luna
MODEL_CHAT=gpt-6-luna
# Reservado para planilhas; o fluxo atual não usa esta opção.
MODEL_PLANILHA=gpt-6-luna

# Opcional: cliente OAuth do Google do tipo Aplicativo da Web.
ID_CLIENT=
KEY_CLIENT=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Obtenha a service_role do Supabase local. Mantenha a chave no backend.
# Sem Docker, SUPABASE_URL usa http://127.0.0.1:54321 por padrão.
# Com Docker, a conexão local usa http://host.docker.internal:54321.
# SUPABASE_URL=
SUPABASE_KEY=
